# Copy to .env on the server and fill in. Never commit the real .env.

# Password for signing in to the web app. Required on a public server.
WANDER_PASSWORD=

# Bearer token for agents: the MCP endpoint (/mcp) and the REST API.
# Generate one with: openssl rand -base64 32 | tr -d '=+/'
WANDER_API_TOKEN=

# Signs login cookies. Any long random string; changing it signs everyone out.
SESSION_SECRET=

# Gemini powers Smart add, Ask, year-in-review, trip names and Where next.
# Get a key at https://aistudio.google.com/apikey
# Optional: AI features can also be set up in the app (AI settings), with Gemini, OpenAI or Anthropic keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_SMART=gemini-flash-latest

# Optional: AeroDataBox via RapidAPI, for "Look up" by flight number + date.
AERODATABOX_API_KEY=

# People whose flights you log, as id:Name pairs. "me" is you. Only used the first time;
# after that, edit them in the app (Logbook → People).
WANDER_PEOPLE=me:Me

# true lets anyone with the link view (not edit) the logbook.
PUBLIC_READ=false

# Keep true behind HTTPS. Set false only for plain-http local testing.
COOKIE_SECURE=true
